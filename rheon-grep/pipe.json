{
  "$schema": "https://oh-my-hsh.navii.online/schemas/pipe-v1.json",
  "id": "rheon-grep",
  "name": "rheon-grep",
  "bin_name": "rheon-grep",
  "version": "4.1.0",
  "description": "Search like rg (same engine, flags, output); Rheon records with --rheon.",
  "usage": "rheon-grep PATTERN [PATH...]   (--rheon for records)",
  "author": "takakix2",
  "license": "MIT",
  "runtime": "binary",
  "side_effects": [],
  "replaces": [
    "flux-grep"
  ],
  "tags": [
    "search",
    "filter",
    "official"
  ],
  "min_hsh_version": "0.1.0",
  "verbs": [
    {
      "verb": "rhg",
      "template": "rheon-grep --rheon {pattern} {path}",
      "args": [
        {
          "name": "pattern",
          "type": "str"
        },
        {
          "name": "path",
          "type": "path"
        }
      ]
    },
    {
      "verb": "rhg",
      "template": "rheon-grep --rheon {pattern}",
      "args": [
        {
          "name": "pattern",
          "type": "str"
        }
      ]
    }
  ],
  "platforms": [
    "linux-x86_64",
    "windows-x86_64"
  ]
}

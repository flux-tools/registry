{
  "$schema": "https://oh-my-hsh.navii.online/schemas/pipe-v1.json",
  "id": "rheon-eye",
  "name": "rheon-eye",
  "bin_name": "rheon-eye",
  "version": "0.2.1",
  "description": "High-speed filesystem scanner. Streams directory structure as Flux NDJSON.",
  "usage": "rheon-eye ~/project --detail",
  "author": "takakix2",
  "license": "MIT",
  "runtime": "binary",
  "side_effects": [],
  "replaces": [
    "flux-eye"
  ],
  "tags": [
    "filesystem",
    "scanner",
    "official"
  ],
  "min_hsh_version": "0.1.0",
  "verbs": [
    {
      "verb": "rheye",
      "template": "rheon-eye {path} --detail",
      "args": [
        {
          "name": "path",
          "type": "path"
        }
      ]
    },
    {
      "verb": "feye",
      "template": "rheon-eye {path} --detail",
      "args": [
        {
          "name": "path",
          "type": "path"
        }
      ]
    },
    {
      "verb": "flux-eye",
      "template": "rheon-eye",
      "args": []
    }
  ],
  "category": "source",
  "platforms": [
    "linux-x86_64",
    "windows-x86_64",
    "macos-aarch64"
  ]
}

{
  "$schema": "https://oh-my-hsh.navii.online/schemas/pipe-v1.json",
  "id": "flux-read",
  "name": "flux-read",
  "bin_name": "flux-read",
  "version": "3.4.0",
  "description": "Token-budgeted reader for a path or the files upstream records name.",
  "notes": "Token-budgeted file reader. Reads a path, or the files named by upstream Flux records, and streams their contents as Flux NDJSON.",
  "runtime": "binary",
  "verbs": [
    {
      "verb": "fread",
      "template": "flux-read {path}",
      "args": [
        {
          "name": "path",
          "type": "path"
        }
      ]
    },
    {
      "verb": "fread",
      "template": "flux-read {path} --budget {budget}",
      "args": [
        {
          "name": "path",
          "type": "path"
        },
        {
          "name": "budget",
          "type": "int"
        }
      ]
    },
    {
      "verb": "fread",
      "template": "flux-read {path} --budget {budget}",
      "args": [
        {
          "name": "path",
          "type": "path"
        },
        {
          "name": "budget",
          "type": "str"
        }
      ]
    }
  ],
  "category": [
    "source",
    "filter"
  ],
  "usage": "flux-read /path/to/file --budget 2000   |   flux-eye . --detail | flux-read",
  "platforms": [
    "linux-x86_64",
    "windows-x86_64",
    "macos-aarch64"
  ]
}
